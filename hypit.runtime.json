{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "local": {
      "use": "@hypit/credential-store-local"
    }
  },
  "endpoints": {
    "hypihub.default": {
      "use": "@hypit/provider-hypihub",
      "config": {
        "baseUrl": "https://hypit.ai",
        "apiKey": {
          "store": "local",
          "key": "hypihub.oauth"
        }
      }
    },
    "media.local": {
      "use": "@hypit/media-local"
    },
    "html.local": {
      "use": "@hypit/provider-html-local"
    },
    "image.opencv.local": {
      "use": "@hypit/provider-image-opencv-local"
    },
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "config": {
        "expectedModel": "large-v3",
        "expectedDevice": "cpu",
        "expectedCompute": "int8",
        "alignmentLanguages": [
          "ja"
        ],
        "expectedBatchSize": 4
      }
    }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "whisperx.local"
  }
}