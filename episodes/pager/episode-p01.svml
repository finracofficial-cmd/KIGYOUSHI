<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p01). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch01>
      物語は、アメリカから始まります。 ||
      <1958年|せんきゅうひゃくごじゅうはちねん>、電話会社の研究所が、ポケットに入る無線の呼び出し装置の試験を社内誌で紹介しました。 ||
      想定した利用者は、外回りのセールスマンや医師。電話のベルを、持ち主のポケットまで延ばす。それが狙いでした。 ||
      一方、日本で「ポケットベル」という名前が生まれたのは、<1963年|せんきゅうひゃくろくじゅうさんねん>のことです。 ||
      横浜の<大井電気|おおいでんき>が、工場やビルの中で人を呼び出す装置にこの名前を付けたのが、始まりとされています。 ||
      @{b-ch01-01!}そして、<1968年7月|せんきゅうひゃくろくじゅうはちねんしちがつ>。<日本電信電話公社|にっぽんでんしんでんわこうしゃ>が、東京<23区|にじゅうさんく>でポケットベルのサービスを始めます。 ||
      初代の受信機は、縦およそ<12センチ|じゅうにせんち>、重さ<160グラム|ひゃくろくじゅうぐらむ>。充電式でした。 ||
      できることは、ただ一つ。鳴ること。画面も、文字もありません。 ||
      @{b-ch01-02!}ベルが鳴ったら、近くの公衆電話を探して、会社に電話をかける。 ||
      誰が、何の用で呼んだのか。それを知るには、電話をかけるしかありませんでした。 ||
      それでも、外を歩き回る人にとっては、どこにいても会社とつながれる、画期的な仕組みだったのです。 ||
      @{b-ch01-03!}利用者の中心は、販売、建設、サービスの仕事をする人たちでした。 ||
      <1977年度|せんきゅうひゃくななじゅうななねんど>の末には、この三つの業種だけで、加入者の<75%|ななじゅうごぱーせんと>を占めています。 ||
      <加入数|かにゅうすう>は、サービス開始の翌年春にはおよそ<4,700|よんせんななひゃく>。それが<1978年|せんきゅうひゃくななじゅうはちねん>の春には<72万|ななじゅうにまん>に増えました。 ||
      当時の通信<白書|はくしょ>は、<加入数|かにゅうすう>でアメリカを上回り、世界一になったと書いています。 ||
      @{b-ch01-04!}電波が足りなくなると、<1978年|せんきゅうひゃくななじゅうはちねん>にはデジタル方式を導入。受信機は小さくなり、乾電池で動くようになりました。 ||
      <1981年|せんきゅうひゃくはちじゅういちねん>の春、<加入数|かにゅうすう>は<100万|ひゃくまん>を超えます。 ||
      <1982年|せんきゅうひゃくはちじゅうにねん>には、一台に二つの番号を付け、鳴り方の違いで、誰からの呼び出しかを聞き分けられるサービスも始まりました。 ||
      やがて、音を消して光だけで知らせる機種も登場します。会議の最中でも、そっと呼び出しに気づけるように。 ||
      ただ、この時代のポケベルは、一つの組織が全国で提供するサービスでした。 ||
      その独占に、やがて大きな風穴が開きます。
    </ch01>
  </script>
  <asset:Image id="img-us-lab-1958" src="./assets/derived/img/us-lab-1958.jpg"/>
  <asset:Image id="img-tokyo-1968-salesman" src="./assets/derived/img/tokyo-1968-salesman.jpg"/>
  <asset:Image id="img-showa-public-phone" src="./assets/derived/img/showa-public-phone.jpg"/>
  <asset:Image id="img-construction-site-1970s" src="./assets/derived/img/construction-site-1970s.jpg"/>
  <asset:Image id="img-radio-tower-1978" src="./assets/derived/img/radio-tower-1978.jpg"/>
  <asset:Audio id="narr-ch01" src="./assets/narration/ch01.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-us-lab-1958" width="1536" height="1024"/>
  <space:Extent id="ext-tokyo-1968-salesman" width="1536" height="1024"/>
  <space:Extent id="ext-showa-public-phone" width="1536" height="1024"/>
  <space:Extent id="ext-construction-site-1970s" width="1536" height="1024"/>
  <space:Extent id="ext-radio-tower-1978" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch01-media" source={narr-ch01} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch01-align" narrative={story} segment={story.segment.ch01} media={ch01-media.media} domain={ch01-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="ch01-tail.end">
    <time:Window id="card-ch01" from="start" for="4s"/>
    <time:Window id="ch01" from="card-ch01.end" for={ch01-media.extent}/>
    <time:Window id="ch01-tail" from="ch01.end" for="1200ms"/>
    <time:Window id="body-ch01" from="ch01.start" until="ch01-tail.end"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch01-align.alignment} domain={ch01-media.domain} window={film.ch01}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch01-01-at" projection={story-time} at={story.moment.b-ch01-01}/>
  <time:Instant id="b-ch01-01-in" timeline={film.timeline} at={b-ch01-01-at} offset="-16f"/>
  <time:Instant id="b-ch01-01-done" timeline={film.timeline} at={b-ch01-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch01-02-at" projection={story-time} at={story.moment.b-ch01-02}/>
  <time:Instant id="b-ch01-02-in" timeline={film.timeline} at={b-ch01-02-at} offset="-16f"/>
  <time:Instant id="b-ch01-02-done" timeline={film.timeline} at={b-ch01-02-at} offset="+8f"/>
  <semantic:Instant id="b-ch01-03-at" projection={story-time} at={story.moment.b-ch01-03}/>
  <time:Instant id="b-ch01-03-in" timeline={film.timeline} at={b-ch01-03-at} offset="-16f"/>
  <time:Instant id="b-ch01-03-done" timeline={film.timeline} at={b-ch01-03-at} offset="+8f"/>
  <semantic:Instant id="b-ch01-04-at" projection={story-time} at={story.moment.b-ch01-04}/>
  <time:Instant id="b-ch01-04-in" timeline={film.timeline} at={b-ch01-04-at} offset="-16f"/>
  <time:Instant id="b-ch01-04-done" timeline={film.timeline} at={b-ch01-04-at} offset="+8f"/>
  <time:Window id="show-ch01-00" timeline={film.timeline} from={film.ch01.start} until={b-ch01-01-done}/>
  <time:Window id="show-ch01-01" timeline={film.timeline} from={b-ch01-01-in} until={b-ch01-02-done}/>
  <time:Window id="show-ch01-02" timeline={film.timeline} from={b-ch01-02-in} until={b-ch01-03-done}/>
  <time:Window id="show-ch01-03" timeline={film.timeline} from={b-ch01-03-in} until={b-ch01-04-done}/>
  <time:Window id="show-ch01-04" timeline={film.timeline} from={b-ch01-04-in} until={film.ch01-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch01-00" image={img-us-lab-1958} extent={ext-us-lab-1958} during={show-ch01-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch01-01" image={img-tokyo-1968-salesman} extent={ext-tokyo-1968-salesman} during={show-ch01-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch01-02" image={img-showa-public-phone} extent={ext-showa-public-phone} during={show-ch01-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch01-03" image={img-construction-site-1970s} extent={ext-construction-site-1970s} during={show-ch01-03} frame={full} z="13" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch01-04" image={img-radio-tower-1978} extent={ext-radio-tower-1978} during={show-ch01-04} frame={full} z="14" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch01" source={ch01-media.media} during={film.ch01}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch01" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch01} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch01" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch01}>FILE</text:Flow>
  <text:Flow id="theme-main-ch01" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch01} motion={text-fade}>なぜ「ポケベル」は消えたのか？</text:Flow>
  <text:Flow id="theme-sub-ch01" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch01} motion={text-fade}>1,000万台が鳴った通信の栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch01" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch01} motion={text-fade}>FILE 01</text:Flow>
  <text:Flow id="card-title-ch01" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch01} motion={text-fade}>会社に電話せよ</text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch01.visual}/>
    <film:Track source={logo-sub-body-ch01.visual}/>
    <film:Track source={theme-main-ch01.visual}/>
    <film:Track source={theme-sub-ch01.visual}/>
    <film:Track source={card-num-ch01.visual}/>
    <film:Track source={card-title-ch01.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
