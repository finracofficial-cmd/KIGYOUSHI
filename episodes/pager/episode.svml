  <time:Timeline id="film" clock={clock} end="endcard.end">
    <time:Window id="op" from="start" for={op-media.extent}/>
    <time:Window id="op-tail" from="op.end" for="800ms"/>
    <time:Window id="body-op" from="op.start" until="op-tail.end"/>
    <time:Window id="ident" from="op-tail.end" for="5s"/>
    <time:Window id="card-ch01" from="ident.end" for="4s"/>
    <time:Window id="ch01" from="card-ch01.end" for={ch01-media.extent}/>
    <time:Window id="ch01-tail" from="ch01.end" for="1200ms"/>
    <time:Window id="body-ch01" from="ch01.start" until="ch01-tail.end"/>
    <time:Window id="card-ch02" from="ch01-tail.end" for="4s"/>
    <time:Window id="ch02" from="card-ch02.end" for={ch02-media.extent}/>
    <time:Window id="ch02-tail" from="ch02.end" for="1200ms"/>
    <time:Window id="body-ch02" from="ch02.start" until="ch02-tail.end"/>
    <time:Window id="card-ch03" from="ch02-tail.end" for="4s"/>
    <time:Window id="ch03" from="card-ch03.end" for={ch03-media.extent}/>
    <time:Window id="ch03-tail" from="ch03.end" for="1200ms"/>
    <time:Window id="body-ch03" from="ch03.start" until="ch03-tail.end"/>
    <time:Window id="card-ch04" from="ch03-tail.end" for="4s"/>
    <time:Window id="ch04" from="card-ch04.end" for={ch04-media.extent}/>
    <time:Window id="ch04-tail" from="ch04.end" for="1200ms"/>
    <time:Window id="body-ch04" from="ch04.start" until="ch04-tail.end"/>
    <time:Window id="card-ch05" from="ch04-tail.end" for="4s"/>
    <time:Window id="ch05" from="card-ch05.end" for={ch05-media.extent}/>
    <time:Window id="ch05-tail" from="ch05.end" for="1200ms"/>
    <time:Window id="body-ch05" from="ch05.start" until="ch05-tail.end"/>
    <time:Window id="card-ch06" from="ch05-tail.end" for="4s"/>
    <time:Window id="ch06" from="card-ch06.end" for={ch06-media.extent}/>
    <time:Window id="ch06-tail" from="ch06.end" for="1200ms"/>
    <time:Window id="body-ch06" from="ch06.start" until="ch06-tail.end"/>
    <time:Window id="credits" from="ch06-tail.end" for="28s"/>
    <time:Window id="endcard" from="credits.end" for="6s"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={op-align.alignment} domain={op-media.domain} window={film.op}/>
    <semantic:Map alignment={ch01-align.alignment} domain={ch01-media.domain} window={film.ch01}/>
    <semantic:Map alignment={ch02-align.alignment} domain={ch02-media.domain} window={film.ch02}/>
    <semantic:Map alignment={ch03-align.alignment} domain={ch03-media.domain} window={film.ch03}/>
    <semantic:Map alignment={ch04-align.alignment} domain={ch04-media.domain} window={film.ch04}/>
    <semantic:Map alignment={ch05-align.alignment} domain={ch05-media.domain} window={film.ch05}/>
    <semantic:Map alignment={ch06-align.alignment} domain={ch06-media.domain} window={film.ch06}/>
  </semantic:Projection>
