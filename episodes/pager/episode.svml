  <time:Window id="show-ch02-03" timeline={film.timeline} from={b-ch02-03-in} until={b-ch02-04-done}/>
  <time:Window id="show-ch02-04" timeline={film.timeline} from={b-ch02-04-in} until={film.ch02-tail.end}/>
  <semantic:Instant id="b-ch03-01-at" projection={story-time} at={story.moment.b-ch03-01}/>
