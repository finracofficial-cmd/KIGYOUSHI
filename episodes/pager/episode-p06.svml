<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p06). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch06>
      大雨や台風の夜。街の防災スピーカーの声は、雨音にかき消され、家の中までは届きにくいことがあります。 ||
      ポケベルの電波は、出力がおよそ<250ワット|にひゃくごじゅうわっと>。波長はおよそ<1メートル|いちめーとる>で、窓から家の中に入り込みやすい性質を持っていました。 ||
      <2016年|にせんじゅうろくねん>、消防庁は、この電波を使った仕組みを、<防災行政無線|ぼうさいぎょうせいむせん>の代わりとして使えると認めます。 ||
      @{b-ch06-01!}今、この電波は、家の中の防災ラジオに、避難の情報を届けています。 ||
      <2025年3月|にせんにじゅうごねんさんがつ>の末で、これを使う市町村は<77|ななじゅうなな>。 ||
      文字だけを受け取る。返事はできない。建物の奥まで届く。 ||
      かつて弱点とされた一方通行の性質が、今度は、確実に知らせるための強みになっていました。 ||
      海を越えたイギリスでは、<2019年|にせんじゅうきゅうねん>の時点で、国の医療機関がおよそ<13万台|じゅうさんまんだい>のポケベルを使っていました。 ||
      世界のポケベルの、十台に一台以上です。 ||
      @{b-ch06-02!}ポケットベルという名前は、もう売り場にはありません。 ||
      それでも、短い文字で気持ちを伝える習慣は、スマートフォンの画面に残り、窓を越えて届く電波は、今も誰かの命を守っています。 ||
      会社員を呼び出す道具は、若者たちの言葉になり、そして、防災の電波になりました。 ||
      人とつながりたいという気持ちだけで、<1,000万台|いっせんまんだい>まで広がった小さな機械。 ||
      放課後の公衆電話から打たれた「<0840|ぜろはちよんぜろ>」は、確かに、誰かのポケットを鳴らしていたのです。 ||
      ポケットベルの栄枯盛衰。そのファイルを、ここで閉じます。
    </ch06>
  </script>
  <asset:Image id="img-storm-town" src="./assets/derived/img/storm-town.jpg"/>
  <asset:Image id="img-disaster-radio" src="./assets/derived/img/disaster-radio.jpg"/>
  <asset:Image id="img-rooftop-antenna-now" src="./assets/derived/img/rooftop-antenna-now.jpg"/>
  <asset:Image id="img-credits" src="./assets/derived/credits.jpg"/>
  <asset:Audio id="narr-ch06" src="./assets/narration/ch06.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-storm-town" width="1536" height="1024"/>
  <space:Extent id="ext-disaster-radio" width="1536" height="1024"/>
  <space:Extent id="ext-rooftop-antenna-now" width="1536" height="1024"/>
  <space:Extent id="ext-credits" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch06-media" source={narr-ch06} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch06-align" narrative={story} segment={story.segment.ch06} media={ch06-media.media} domain={ch06-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="endcard.end">
    <time:Window id="card-ch06" from="start" for="4s"/>
    <time:Window id="ch06" from="card-ch06.end" for={ch06-media.extent}/>
    <time:Window id="ch06-tail" from="ch06.end" for="1200ms"/>
    <time:Window id="body-ch06" from="ch06.start" until="ch06-tail.end"/>
    <time:Window id="credits" from="ch06-tail.end" for="28s"/>
    <time:Window id="endcard" from="credits.end" for="6s"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch06-align.alignment} domain={ch06-media.domain} window={film.ch06}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch06-01-at" projection={story-time} at={story.moment.b-ch06-01}/>
  <time:Instant id="b-ch06-01-in" timeline={film.timeline} at={b-ch06-01-at} offset="-16f"/>
  <time:Instant id="b-ch06-01-done" timeline={film.timeline} at={b-ch06-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch06-02-at" projection={story-time} at={story.moment.b-ch06-02}/>
  <time:Instant id="b-ch06-02-in" timeline={film.timeline} at={b-ch06-02-at} offset="-16f"/>
  <time:Instant id="b-ch06-02-done" timeline={film.timeline} at={b-ch06-02-at} offset="+8f"/>
  <time:Window id="show-ch06-00" timeline={film.timeline} from={film.ch06.start} until={b-ch06-01-done}/>
  <time:Window id="show-ch06-01" timeline={film.timeline} from={b-ch06-01-in} until={b-ch06-02-done}/>
  <time:Window id="show-ch06-02" timeline={film.timeline} from={b-ch06-02-in} until={film.ch06-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch06-00" image={img-storm-town} extent={ext-storm-town} during={show-ch06-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch06-01" image={img-disaster-radio} extent={ext-disaster-radio} during={show-ch06-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch06-02" image={img-rooftop-antenna-now} extent={ext-rooftop-antenna-now} during={show-ch06-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-credits" image={img-credits} extent={ext-credits} during={film.credits} frame={full} z="900" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch06" source={ch06-media.media} during={film.ch06}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch06" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch06} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch06" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch06}>FILE</text:Flow>
  <text:Flow id="logo-credits" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.credits} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-credits" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.credits}>FILE</text:Flow>
  <text:Flow id="theme-main-ch06" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch06} motion={text-fade}>なぜ「ポケベル」は消えたのか？</text:Flow>
  <text:Flow id="theme-sub-ch06" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch06} motion={text-fade}>1,000万台が鳴った通信の栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch06" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch06} motion={text-fade}>FILE 06</text:Flow>
  <text:Flow id="card-title-ch06" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch06} motion={text-fade}>電波は残った</text:Flow>
  <text:Motion id="credits-roll"><text:ItemKeyframe at="0" y="1080"/><text:ItemKeyframe at="840" y="-1791"/></text:Motion>
  <text:Flow id="credits-text" timeline={film.timeline} within={credits-frame} style={credits-style} z="950" align="center" block-align="start" during={film.credits} motion={credits-roll} block-size="hug"><text:P><text:Span style={credits-head-style}>参考資料</text:Span><text:Break/>総務省（郵政省）『通信白書』昭和48〜平成12年版、『情報通信白書』平成13年版・令和元年版<text:Break/>総務省「電気通信サービスの契約数及びシェア」統計データ<text:Break/>一般社団法人電気通信事業者協会 契約数月次統計（1996〜1997年）<text:Break/>国立科学博物館 産業技術史資料データベース「ポケットベル」<text:Break/>大井電気株式会社 沿革<text:Break/>NTTドコモ 会社沿革・報道発表資料<text:Break/>東京テレメッセージ株式会社 ブランドストーリー・お知らせ<text:Break/>消防庁「防災行政無線等の整備状況」<text:Break/>INTERNET Watch（1999年）、ケータイWatch（2001・2002・2005年）<text:Break/>ITmedia（2007・2018・2026年）<text:Break/>J-CAST ニュース（2018・2019年）<text:Break/>日経ビジネス、日経クロステック（2019・2020年）<text:Break/>文春オンライン（2018・2020年）<text:Break/>日刊SPA!（2019年）、SoraNews24（2019年）<text:Break/>nippon.com「iモードの終了」（2026年）<text:Break/>Y!mobile「PHSサービス終了特設サイト」<text:Break/>Bell Laboratories Record（1958年）<text:Break/><text:Span style={credits-head-style}>　</text:Span><text:Break/>本動画は、公開されている企業資料・報道・書籍などをもとに制作しています。資料によって記載内容や数値が異なる場合は、複数の資料を確認したうえで構成しています。登場する企業名・商品名・ブランド名・ロゴは各社の商標または登録商標です。映像はイメージであり、実際の人物・建物・製品とは異なる場合があります。<text:Break/><text:Span style={credits-head-style}>　</text:Span><text:Break/><text:Span style={credits-head-style}>制作　栄枯盛衰ファイル</text:Span></text:P></text:Flow>
  <text:Flow id="ending-text" timeline={film.timeline} within={ending-frame} style={ending-style} z="60" align="center" block-align="center" during={film.endcard} motion={text-fade}><text:P>ご視聴ありがとうございました<text:Break/>チャンネル登録・高評価をお願いします</text:P></text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch06.visual}/>
    <film:Track source={logo-sub-body-ch06.visual}/>
    <film:Track source={logo-credits.visual}/>
    <film:Track source={logo-sub-credits.visual}/>
    <film:Track source={theme-main-ch06.visual}/>
    <film:Track source={theme-sub-ch06.visual}/>
    <film:Track source={card-num-ch06.visual}/>
    <film:Track source={card-title-ch06.visual}/>
    <film:Track source={credits-text.visual}/>
    <film:Track source={ending-text.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
