<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p02). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch02>
      <1985年4月|せんきゅうひゃくはちじゅうごねんしがつ>、電気通信事業法が施行され、<電電公社|でんでんこうしゃ>は民営化されて、<NTT|えぬてぃーてぃー>になりました。 ||
      通信の世界に、競争が持ち込まれたのです。 ||
      このとき、新しく参入した会社の多くが選んだのが、ポケットベルでした。 ||
      <1986年度|せんきゅうひゃくはちじゅうろくねんど>以降に参入した<19社|じゅうきゅうしゃ>のうち、<15社|じゅうごしゃ>が無線呼び出しの会社です。 ||
      理由は、始めるための設備投資が小さく、参入しやすかったからだと、<白書|はくしょ>は分析しています。 ||
      @{b-ch02-01!}<1987年9月1日|せんきゅうひゃくはちじゅうななねんくがつついたち>、新しい事業者の第一号として、<九州ネットワークシステム|きゅうしゅうねっとわーくしすてむ>がサービスを開始。 ||
      翌月には、東京電力などが出資した<東京テレメッセージ|とうきょうてれめっせーじ>も続きます。 ||
      多くは地元の企業が中心となり、おおむね県ごとに一社ずつ、新しいポケベル会社が生まれていきました。 ||
      最初は赤字でした。<1988年度|せんきゅうひゃくはちじゅうはちねんど>の上半期、新しい事業者の損失は合わせて<19億円|じゅうきゅうおくえん>。 ||
      しかし、その一年後には黒字に転じます。<1990年度|せんきゅうひゃくきゅうじゅうねんど>には、すべての都道府県で、二つの会社から選べるようになりました。 ||
      @{b-ch02-02!}同じ<1987年|せんきゅうひゃくはちじゅうななねん>、ポケベルに大きな変化が起きます。数字が表示できるようになったのです。 ||
      画面に出せるのは、最大<12桁|じゅうにけた>の数字だけ。それでも、意味は大きく変わりました。 ||
      呼び出した人が、自分の電話番号を送れば、受け取った人は会社を通さずに、直接かけ直せる。 ||
      名刺にポケベルの番号を刷る人も現れました。通信<白書|はくしょ>は、数字を表示するポケベルを「動く伝言板」と表現しています。 ||
      @{b-ch02-03!}端末も変わっていきます。ペンの形、薄いカードの形。<1990年|せんきゅうひゃくきゅうじゅうねん>ごろからは、白やピンクといったカラフルな端末も登場しました。 ||
      <1990年9月|せんきゅうひゃくきゅうじゅうねんくがつ>の末、全国の契約数は<469万|よんひゃくろくじゅうきゅうまん>。 ||
      競争によって料金は下がり、ポケベルは、少しずつ身近な道具になっていきます。 ||
      @{b-ch02-04!}そして、この「数字」に、もう一つの使い道を見つけた人たちがいました。 ||
      数字の並びに意味を込めて、暗号のように送る。 ||
      当時の新聞は、これをいち早く使っていたのが、福岡の麻薬の密売人や、大阪の暴走族だったと報じています。 ||
      ところが、この数字の暗号を、本当に使いこなしたのは、まったく別の人たちでした。
    </ch02>
  </script>
  <asset:Image id="img-liberalization-1985" src="./assets/derived/img/liberalization-1985.jpg"/>
  <asset:Image id="img-new-carrier-office-1987" src="./assets/derived/img/new-carrier-office-1987.jpg"/>
  <asset:Image id="img-business-card-pager" src="./assets/derived/img/business-card-pager.jpg"/>
  <asset:Image id="img-colorful-pagers-1990" src="./assets/derived/img/colorful-pagers-1990.jpg"/>
  <asset:Image id="img-shady-street-1990" src="./assets/derived/img/shady-street-1990.jpg"/>
  <asset:Audio id="narr-ch02" src="./assets/narration/ch02.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-liberalization-1985" width="1536" height="1024"/>
  <space:Extent id="ext-new-carrier-office-1987" width="1536" height="1024"/>
  <space:Extent id="ext-business-card-pager" width="1536" height="1024"/>
  <space:Extent id="ext-colorful-pagers-1990" width="1536" height="1024"/>
  <space:Extent id="ext-shady-street-1990" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch02-media" source={narr-ch02} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch02-align" narrative={story} segment={story.segment.ch02} media={ch02-media.media} domain={ch02-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="ch02-tail.end">
    <time:Window id="card-ch02" from="start" for="4s"/>
    <time:Window id="ch02" from="card-ch02.end" for={ch02-media.extent}/>
    <time:Window id="ch02-tail" from="ch02.end" for="1200ms"/>
    <time:Window id="body-ch02" from="ch02.start" until="ch02-tail.end"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch02-align.alignment} domain={ch02-media.domain} window={film.ch02}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch02-01-at" projection={story-time} at={story.moment.b-ch02-01}/>
  <time:Instant id="b-ch02-01-in" timeline={film.timeline} at={b-ch02-01-at} offset="-16f"/>
  <time:Instant id="b-ch02-01-done" timeline={film.timeline} at={b-ch02-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch02-02-at" projection={story-time} at={story.moment.b-ch02-02}/>
  <time:Instant id="b-ch02-02-in" timeline={film.timeline} at={b-ch02-02-at} offset="-16f"/>
  <time:Instant id="b-ch02-02-done" timeline={film.timeline} at={b-ch02-02-at} offset="+8f"/>
  <semantic:Instant id="b-ch02-03-at" projection={story-time} at={story.moment.b-ch02-03}/>
  <time:Instant id="b-ch02-03-in" timeline={film.timeline} at={b-ch02-03-at} offset="-16f"/>
  <time:Instant id="b-ch02-03-done" timeline={film.timeline} at={b-ch02-03-at} offset="+8f"/>
  <semantic:Instant id="b-ch02-04-at" projection={story-time} at={story.moment.b-ch02-04}/>
  <time:Instant id="b-ch02-04-in" timeline={film.timeline} at={b-ch02-04-at} offset="-16f"/>
  <time:Instant id="b-ch02-04-done" timeline={film.timeline} at={b-ch02-04-at} offset="+8f"/>
  <time:Window id="show-ch02-00" timeline={film.timeline} from={film.ch02.start} until={b-ch02-01-done}/>
  <time:Window id="show-ch02-01" timeline={film.timeline} from={b-ch02-01-in} until={b-ch02-02-done}/>
  <time:Window id="show-ch02-02" timeline={film.timeline} from={b-ch02-02-in} until={b-ch02-03-done}/>
  <time:Window id="show-ch02-03" timeline={film.timeline} from={b-ch02-03-in} until={b-ch02-04-done}/>
  <time:Window id="show-ch02-04" timeline={film.timeline} from={b-ch02-04-in} until={film.ch02-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch02-00" image={img-liberalization-1985} extent={ext-liberalization-1985} during={show-ch02-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch02-01" image={img-new-carrier-office-1987} extent={ext-new-carrier-office-1987} during={show-ch02-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch02-02" image={img-business-card-pager} extent={ext-business-card-pager} during={show-ch02-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch02-03" image={img-colorful-pagers-1990} extent={ext-colorful-pagers-1990} during={show-ch02-03} frame={full} z="13" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch02-04" image={img-shady-street-1990} extent={ext-shady-street-1990} during={show-ch02-04} frame={full} z="14" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch02" source={ch02-media.media} during={film.ch02}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch02" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch02} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch02" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch02}>FILE</text:Flow>
  <text:Flow id="theme-main-ch02" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch02} motion={text-fade}>なぜ「ポケベル」は消えたのか？</text:Flow>
  <text:Flow id="theme-sub-ch02" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch02} motion={text-fade}>1,000万台が鳴った通信の栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch02" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch02} motion={text-fade}>FILE 02</text:Flow>
  <text:Flow id="card-title-ch02" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch02} motion={text-fade}>数字が届いた日</text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch02.visual}/>
    <film:Track source={logo-sub-body-ch02.visual}/>
    <film:Track source={theme-main-ch02.visual}/>
    <film:Track source={theme-sub-ch02.visual}/>
    <film:Track source={card-num-ch02.visual}/>
    <film:Track source={card-title-ch02.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
