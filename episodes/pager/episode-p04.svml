<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p04). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch04>
      <1996年3月|せんきゅうひゃくきゅうじゅうろくねんさんがつ>の末。ポケベルの契約数は、年度末として過去最高の<1,061万|せんろくじゅういちまん>を記録しました。 ||
      ところが同じ日、携帯電話は<1,020万|せんにじゅうまん>、<PHS|ぴーえいちえす>は<151万|ひゃくごじゅういちまん>。二つを合わせると、すでにポケベルを上回っていました。 ||
      翌月には、携帯電話だけでもポケベルを追い抜きます。 ||
      携帯電話が、急に安くなっていたのです。 ||
      保証金の廃止、端末の売り切り、そして料金の自由化。制度が変わるたびに競争が進み、料金は下がっていきました。 ||
      @{b-ch04-01!}もう一つの相手が、<1995年7月|せんきゅうひゃくきゅうじゅうごねんしちがつ>に始まった<PHS|ぴーえいちえす>です。 ||
      基本料金が安く、通話料は公衆電話に近い。ポケベルを使っていた若者たちが、次々に乗り換えていきました。 ||
      国の調査では、サービスの種類を乗り換えた人は<38.4%|さんじゅうはってんよんぱーせんと>。ポケベルから<PHS|ぴーえいちえす>への乗り換えは、<15歳|じゅうごさい>から<19歳|じゅうきゅうさい>に目立ちました。 ||
      そして、<1996年11月|せんきゅうひゃくきゅうじゅうろくねんじゅういちがつ>。<PHS|ぴーえいちえす>で、<20文字|にじゅうもじ>のメッセージを送り合える、<Pメール|ぴーめーる>が始まります。 ||
      @{b-ch04-02!}<1997年|せんきゅうひゃくきゅうじゅうななねん>には、ドコモの携帯電話でもショートメールが始まりました。 ||
      そして<1999年2月|せんきゅうひゃくきゅうじゅうきゅうねんにがつ>、<iモード|あいもーど>が登場します。 ||
      電話も、メールも、一台でできる。ポケベルだけが持っていた「文字が届く」という強みは、消えていきました。 ||
      @{b-ch04-03!}では、ポケベルが消えた理由は、携帯電話に負けたこと、それだけでしょうか。 ||
      ポケベルには、生まれつきの限界がありました。受け取ることしかできないのです。 ||
      メッセージが届いても、返事をするには、また電話を探さなければならない。 ||
      携帯電話なら、その場ですぐに返せる。一方通行という作りそのものが、時代に合わなくなっていました。 ||
      @{b-ch04-04!}さらに、業界の形にも弱さがありました。 ||
      ブームの中で、各社は大きな投資を続けていました。 ||
      首都圏の<東京テレメッセージ|とうきょうてれめっせーじ>は、<1993年度|せんきゅうひゃくきゅうじゅうさんねんど>からの<4年間|よねんかん>で、およそ<660億円|ろっぴゃくろくじゅうおくえん>を投資したとされます。 ||
      最も多いときで、およそ<134万|ひゃくさんじゅうよんまん>あった契約は、ブームが終わると急速に減っていきました。 ||
      <1999年5月|せんきゅうひゃくきゅうじゅうきゅうねんごがつ>、<東京テレメッセージ|とうきょうてれめっせーじ>は会社更生法の適用を申請します。負債は、およそ<250億円|にひゃくごじゅうおくえん>。 ||
      そのとき残っていた契約は、<36万|さんじゅうろくまん>でした。 ||
      @{b-ch04-05!}全国の契約数は、<1999年3月|せんきゅうひゃくきゅうじゅうきゅうねんさんがつ>の末に<376万|さんびゃくななじゅうろくまん>。たった一年で、半分近くが消えました。 ||
      業界も、手をこまねいていたわけではありません。 ||
      <1999年2月|せんきゅうひゃくきゅうじゅうきゅうねんにがつ>には、呼び出す側が料金を払い、持つ側の月額を無料や大幅な値下げにする料金制度を始めます。 ||
      減り方は緩やかになりました。しかし、流れそのものは変わりませんでした。 ||
      <2002年3月|にせんにねんさんがつ>の末、契約数はおよそ<114万|ひゃくじゅうよんまん>。ピークの、およそ一割です。 ||
      県ごとに細かく分かれていた新しい事業者は、需要が減ると、支えきれなくなります。 ||
      <2001年|にせんいちねん>の春までに、<31社|さんじゅういっしゃ>のうち<29社|にじゅうきゅうしゃ>が事業から撤退しました。 ||
      そして<2001年|にせんいちねん>の元日、ドコモは、<1968年|せんきゅうひゃくろくじゅうはちねん>から使ってきた「ポケットベル」という名前をやめ、「クイックキャスト」に変えます。 ||
      利用者が、個人から法人へと移ったからでした。 ||
      ポケベルは、名前さえも手放したのです。 ||
      それでも、その電波は、まだ止まりませんでした。
    </ch04>
  </script>
  <asset:Image id="img-crossover-1996" src="./assets/derived/img/crossover-1996.jpg"/>
  <asset:Image id="img-phs-1995" src="./assets/derived/img/phs-1995.jpg"/>
  <asset:Image id="img-keitai-shop-1999" src="./assets/derived/img/keitai-shop-1999.jpg"/>
  <asset:Image id="img-one-way" src="./assets/derived/img/one-way.jpg"/>
  <asset:Image id="img-empty-office-1999" src="./assets/derived/img/empty-office-1999.jpg"/>
  <asset:Image id="img-closed-counters-2001" src="./assets/derived/img/closed-counters-2001.jpg"/>
  <asset:Audio id="narr-ch04" src="./assets/narration/ch04.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-crossover-1996" width="1536" height="1024"/>
  <space:Extent id="ext-phs-1995" width="1536" height="1024"/>
  <space:Extent id="ext-keitai-shop-1999" width="1536" height="1024"/>
  <space:Extent id="ext-one-way" width="1536" height="1024"/>
  <space:Extent id="ext-empty-office-1999" width="1536" height="1024"/>
  <space:Extent id="ext-closed-counters-2001" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch04-media" source={narr-ch04} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch04-align" narrative={story} segment={story.segment.ch04} media={ch04-media.media} domain={ch04-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="ch04-tail.end">
    <time:Window id="card-ch04" from="start" for="4s"/>
    <time:Window id="ch04" from="card-ch04.end" for={ch04-media.extent}/>
    <time:Window id="ch04-tail" from="ch04.end" for="1200ms"/>
    <time:Window id="body-ch04" from="ch04.start" until="ch04-tail.end"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch04-align.alignment} domain={ch04-media.domain} window={film.ch04}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch04-01-at" projection={story-time} at={story.moment.b-ch04-01}/>
  <time:Instant id="b-ch04-01-in" timeline={film.timeline} at={b-ch04-01-at} offset="-16f"/>
  <time:Instant id="b-ch04-01-done" timeline={film.timeline} at={b-ch04-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch04-02-at" projection={story-time} at={story.moment.b-ch04-02}/>
  <time:Instant id="b-ch04-02-in" timeline={film.timeline} at={b-ch04-02-at} offset="-16f"/>
  <time:Instant id="b-ch04-02-done" timeline={film.timeline} at={b-ch04-02-at} offset="+8f"/>
  <semantic:Instant id="b-ch04-03-at" projection={story-time} at={story.moment.b-ch04-03}/>
  <time:Instant id="b-ch04-03-in" timeline={film.timeline} at={b-ch04-03-at} offset="-16f"/>
  <time:Instant id="b-ch04-03-done" timeline={film.timeline} at={b-ch04-03-at} offset="+8f"/>
  <semantic:Instant id="b-ch04-04-at" projection={story-time} at={story.moment.b-ch04-04}/>
  <time:Instant id="b-ch04-04-in" timeline={film.timeline} at={b-ch04-04-at} offset="-16f"/>
  <time:Instant id="b-ch04-04-done" timeline={film.timeline} at={b-ch04-04-at} offset="+8f"/>
  <semantic:Instant id="b-ch04-05-at" projection={story-time} at={story.moment.b-ch04-05}/>
  <time:Instant id="b-ch04-05-in" timeline={film.timeline} at={b-ch04-05-at} offset="-16f"/>
  <time:Instant id="b-ch04-05-done" timeline={film.timeline} at={b-ch04-05-at} offset="+8f"/>
  <time:Window id="show-ch04-00" timeline={film.timeline} from={film.ch04.start} until={b-ch04-01-done}/>
  <time:Window id="show-ch04-01" timeline={film.timeline} from={b-ch04-01-in} until={b-ch04-02-done}/>
  <time:Window id="show-ch04-02" timeline={film.timeline} from={b-ch04-02-in} until={b-ch04-03-done}/>
  <time:Window id="show-ch04-03" timeline={film.timeline} from={b-ch04-03-in} until={b-ch04-04-done}/>
  <time:Window id="show-ch04-04" timeline={film.timeline} from={b-ch04-04-in} until={b-ch04-05-done}/>
  <time:Window id="show-ch04-05" timeline={film.timeline} from={b-ch04-05-in} until={film.ch04-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch04-00" image={img-crossover-1996} extent={ext-crossover-1996} during={show-ch04-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch04-01" image={img-phs-1995} extent={ext-phs-1995} during={show-ch04-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch04-02" image={img-keitai-shop-1999} extent={ext-keitai-shop-1999} during={show-ch04-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch04-03" image={img-one-way} extent={ext-one-way} during={show-ch04-03} frame={full} z="13" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch04-04" image={img-empty-office-1999} extent={ext-empty-office-1999} during={show-ch04-04} frame={full} z="14" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch04-05" image={img-closed-counters-2001} extent={ext-closed-counters-2001} during={show-ch04-05} frame={full} z="15" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch04" source={ch04-media.media} during={film.ch04}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch04" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch04} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch04" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch04}>FILE</text:Flow>
  <text:Flow id="theme-main-ch04" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch04} motion={text-fade}>なぜ「ポケベル」は消えたのか？</text:Flow>
  <text:Flow id="theme-sub-ch04" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch04} motion={text-fade}>1,000万台が鳴った通信の栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch04" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch04} motion={text-fade}>FILE 04</text:Flow>
  <text:Flow id="card-title-ch04" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch04} motion={text-fade}>なぜ鳴らなくなったのか</text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch04.visual}/>
    <film:Track source={logo-sub-body-ch04.visual}/>
    <film:Track source={theme-main-ch04.visual}/>
    <film:Track source={theme-sub-ch04.visual}/>
    <film:Track source={card-num-ch04.visual}/>
    <film:Track source={card-title-ch04.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
