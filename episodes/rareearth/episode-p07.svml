<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p07). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch07>
      東京からおよそ<1,900キロ|せんきゅうひゃくきろ>。日本の最も東にある島、<南鳥島|みなみとりしま>。 ||
      この島のまわりの深い海の底に、レアアースを含む泥が眠っています。 ||
      <2013年|にせんじゅうさんねん>、東京大学の<加藤泰浩|かとうやすひろ>教授らは、ここでジスプロシウムの濃さが中国の鉱山の<32倍|さんじゅうにばい>という泥を見つけました。 ||
      @{b-ch07-01!}最も有望な区域だけで、ジスプロシウムは世界の需要の<56年|ごじゅうろくねん>分にあたる、という推定もあります。 ||
      陸の鉱石と違い、放射性の物質をほとんど含まない、と研究者は説明します。 ||
      問題は、その場所です。泥があるのは、水深およそ<5,600メートル|ごせんろっぴゃくめーとる>の海の底でした。 ||
      @{b-ch07-02!}<2026年1月|にせんにじゅうろくねんいちがつ>、<地球深部探査船|ちきゅうしんぶたんさせん><「ち|ち>きゅう」が、<南鳥島|みなみとりしま>の沖へ向かいます。 ||
      高さ<7メートル|ななめーとる>近い波の中、パイプをつなぎ、<5,569メートル|ごせんごひゃくろくじゅうきゅうめーとる>の海底まで、泥をほぐす装置を降ろしました。 ||
      <2月1日|にがつついたち>の真夜中過ぎ、泥が、船の上へ上がってきます。 ||
      <海洋研究開発機構|かいようけんきゅうかいはつきこう>、<JAMSTEC|じゃむすてっく>によれば、この深さから泥を連続して揚げたのは、世界で初めてです。 ||
      @{b-ch07-03!}回収した泥は、およそ<50トン|ごじゅっとん>。 ||
      含まれるレアアースの半分以上は、イットリウムやジスプロシウムなど、中くらいから重い種類でした。 ||
      いま日本に入りにくくなっている、まさにその種類です。ただし、泥の濃さなどは、まだ公表されていません。 ||
      @{b-ch07-04!}次は<2027年2月|にせんにじゅうななねんにがつ>。<1日|いちにち>におよそ<350トン|さんびゃくごじゅっとん>の泥を揚げる、本格的な試験が予定されています。 ||
      そして<2028年3月|にせんにじゅうはちねんさんがつ>までに、採算が合うかどうかを評価します。 ||
      <「ち|ち>きゅう」を動かすだけで、年に<百数十億円|ひゃくすうじゅうおくえん>かかる、という指摘もあります。 ||
      深海の泥が、中国の値段と競えるのか。分けて精製する力も国内で立て直す必要がある、と専門家は言います。 ||
      @{b-ch07-05!}<18世紀|じゅうはっせいき>、スウェーデンの村で拾われた、重い黒い石。 ||
      レアアースは、レアではありませんでした。まれだったのは、それを掘り、分け、汚れを引き受ける場所でした。 ||
      アメリカはその場所を手放し、中国はそれを引き受けて技術を磨き、世界の供給を握りました。 ||
      そして、最強の磁石を生んだ日本は、原料を海の向こうに頼り続けてきました。 ||
      深い海の底の泥は、その形を変えられるのか。答えが出るのは、まだ少し先のことです。 ||
      レアアースの栄枯盛衰。このファイルは、まだ閉じられそうにありません。
    </ch07>
  </script>
  <asset:Image id="img-minamitorishima" src="./assets/derived/img/minamitorishima.jpg"/>
  <asset:Image id="img-deep-sea-mud" src="./assets/derived/img/deep-sea-mud.jpg"/>
  <asset:Image id="img-chikyu-2026" src="./assets/derived/img/chikyu-2026.jpg"/>
  <asset:Image id="img-mud-on-deck-2026" src="./assets/derived/img/mud-on-deck-2026.jpg"/>
  <asset:Image id="img-pacific-dawn-ending" src="./assets/derived/img/pacific-dawn-ending.jpg"/>
  <asset:Image id="img-credits-ore" src="./assets/derived/img/credits-ore.jpg"/>
  <asset:Image id="img-credits" src="./assets/derived/credits.jpg"/>
  <asset:Audio id="narr-ch07" src="./assets/narration/ch07.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-minamitorishima" width="1536" height="1024"/>
  <space:Extent id="ext-deep-sea-mud" width="1536" height="1024"/>
  <space:Extent id="ext-chikyu-2026" width="1536" height="1024"/>
  <space:Extent id="ext-mud-on-deck-2026" width="1536" height="1024"/>
  <space:Extent id="ext-pacific-dawn-ending" width="1536" height="1024"/>
  <space:Extent id="ext-credits-ore" width="1536" height="1024"/>
  <space:Extent id="ext-credits" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch07-media" source={narr-ch07} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch07-align" narrative={story} segment={story.segment.ch07} media={ch07-media.media} domain={ch07-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="endcard.end">
    <time:Window id="card-ch07" from="start" for="4s"/>
    <time:Window id="ch07" from="card-ch07.end" for={ch07-media.extent}/>
    <time:Window id="ch07-tail" from="ch07.end" for="1200ms"/>
    <time:Window id="body-ch07" from="ch07.start" until="ch07-tail.end"/>
    <time:Window id="credits" from="ch07-tail.end" for="21s"/>
    <time:Window id="endcard" from="credits.end" for="6s"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch07-align.alignment} domain={ch07-media.domain} window={film.ch07}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch07-01-at" projection={story-time} at={story.moment.b-ch07-01}/>
  <time:Instant id="b-ch07-01-in" timeline={film.timeline} at={b-ch07-01-at} offset="-16f"/>
  <time:Instant id="b-ch07-01-done" timeline={film.timeline} at={b-ch07-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch07-02-at" projection={story-time} at={story.moment.b-ch07-02}/>
  <time:Instant id="b-ch07-02-in" timeline={film.timeline} at={b-ch07-02-at} offset="-16f"/>
  <time:Instant id="b-ch07-02-done" timeline={film.timeline} at={b-ch07-02-at} offset="+8f"/>
  <semantic:Instant id="b-ch07-03-at" projection={story-time} at={story.moment.b-ch07-03}/>
  <time:Instant id="b-ch07-03-in" timeline={film.timeline} at={b-ch07-03-at} offset="-16f"/>
  <time:Instant id="b-ch07-03-done" timeline={film.timeline} at={b-ch07-03-at} offset="+8f"/>
  <semantic:Instant id="b-ch07-04-at" projection={story-time} at={story.moment.b-ch07-04}/>
  <time:Instant id="b-ch07-04-in" timeline={film.timeline} at={b-ch07-04-at} offset="-16f"/>
  <time:Instant id="b-ch07-04-done" timeline={film.timeline} at={b-ch07-04-at} offset="+8f"/>
  <semantic:Instant id="b-ch07-05-at" projection={story-time} at={story.moment.b-ch07-05}/>
  <time:Instant id="b-ch07-05-in" timeline={film.timeline} at={b-ch07-05-at} offset="-16f"/>
  <time:Instant id="b-ch07-05-done" timeline={film.timeline} at={b-ch07-05-at} offset="+8f"/>
  <time:Window id="show-ch07-00" timeline={film.timeline} from={film.ch07.start} until={b-ch07-01-done}/>
  <time:Window id="show-ch07-01" timeline={film.timeline} from={b-ch07-01-in} until={b-ch07-02-done}/>
  <time:Window id="show-ch07-02" timeline={film.timeline} from={b-ch07-02-in} until={b-ch07-03-done}/>
  <time:Window id="show-ch07-03" timeline={film.timeline} from={b-ch07-03-in} until={b-ch07-04-done}/>
  <time:Window id="show-ch07-04" timeline={film.timeline} from={b-ch07-04-in} until={b-ch07-05-done}/>
  <time:Window id="show-ch07-05" timeline={film.timeline} from={b-ch07-05-in} until={film.ch07-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch07-00" image={img-minamitorishima} extent={ext-minamitorishima} during={show-ch07-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch07-01" image={img-deep-sea-mud} extent={ext-deep-sea-mud} during={show-ch07-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch07-02" image={img-chikyu-2026} extent={ext-chikyu-2026} during={show-ch07-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch07-03" image={img-mud-on-deck-2026} extent={ext-mud-on-deck-2026} during={show-ch07-03} frame={full} z="13" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch07-04" image={img-pacific-dawn-ending} extent={ext-pacific-dawn-ending} during={show-ch07-04} frame={full} z="14" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch07-05" image={img-credits-ore} extent={ext-credits-ore} during={show-ch07-05} frame={full} z="15" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-credits" image={img-credits} extent={ext-credits} during={film.credits} frame={full} z="900" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch07" source={ch07-media.media} during={film.ch07}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch07" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch07} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch07" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch07}>FILE</text:Flow>
  <text:Flow id="logo-credits" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.credits} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-credits" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.credits}>FILE</text:Flow>
  <text:Flow id="theme-main-ch07" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch07} motion={text-fade}>なぜ「レアアース」は中国に握られたのか？</text:Flow>
  <text:Flow id="theme-sub-ch07" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch07} motion={text-fade}>ありふれた元素をめぐる栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch07" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch07} motion={text-fade}>FILE 07</text:Flow>
  <text:Flow id="card-title-ch07" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch07} motion={text-fade}>南鳥島の泥</text:Flow>
  <text:Motion id="credits-roll"><text:ItemKeyframe at="0" y="1080"/><text:ItemKeyframe at="630" y="-1445"/></text:Motion>
  <text:Flow id="credits-text" timeline={film.timeline} within={credits-frame} style={credits-style} z="950" align="center" block-align="start" during={film.credits} motion={credits-roll} block-size="hug"><text:P><text:Span style={credits-head-style}>参考資料</text:Span><text:Break/>米国地質調査所（USGS）Mineral Commodity Summaries、Minerals Yearbook、Fact Sheet 087-02、Data Series 140<text:Break/>米政府説明責任局（GAO）報告（2010年）、米議会調査局（CRS）報告、米中経済安全保障調査委員会報告（2010年）<text:Break/>中国国務院新聞弁公室「中国の希土類の状況と政策」（2012年）、中国商務部・外交部の公告と発表<text:Break/>国会会議録（2010年、2025年）<text:Break/>世界貿易機関（WTO）紛争案件DS433<text:Break/>JOGMEC 発表資料・鉱物資源マテリアルフロー<text:Break/>海洋研究開発機構（JAMSTEC）・内閣府 SIP 海洋、東京大学・早稲田大学の発表<text:Break/>科学技術振興機構 サイエンスポータル、本田賞の発表、地質調査所月報（1988年）<text:Break/>Molycorp・MP Materials の米証券取引委員会（SEC）提出書類と発表<text:Break/>大同特殊鋼、日立製作所、豊田通商、CISTEC（安全保障貿易情報センター）<text:Break/>ロイター、AP、AFP、共同通信、時事通信、日本経済新聞、nippon.com、Benchmark Mineral Intelligence<text:Break/><text:Span style={credits-head-style}>　</text:Span><text:Break/>本動画は、公開されている企業資料・報道・書籍などをもとに制作しています。資料によって記載内容や数値が異なる場合は、複数の資料を確認したうえで構成しています。登場する企業名・商品名・ブランド名・ロゴは各社の商標または登録商標です。映像はイメージであり、実際の人物・建物・製品とは異なる場合があります。<text:Break/><text:Span style={credits-head-style}>　</text:Span><text:Break/><text:Span style={credits-head-style}>制作　栄枯盛衰ファイル</text:Span></text:P></text:Flow>
  <text:Flow id="ending-text" timeline={film.timeline} within={ending-frame} style={ending-style} z="60" align="center" block-align="center" during={film.endcard} motion={text-fade}><text:P>ご視聴ありがとうございました<text:Break/>チャンネル登録・高評価をお願いします</text:P></text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch07.visual}/>
    <film:Track source={logo-sub-body-ch07.visual}/>
    <film:Track source={logo-credits.visual}/>
    <film:Track source={logo-sub-credits.visual}/>
    <film:Track source={theme-main-ch07.visual}/>
    <film:Track source={theme-sub-ch07.visual}/>
    <film:Track source={card-num-ch07.visual}/>
    <film:Track source={card-title-ch07.visual}/>
    <film:Track source={credits-text.visual}/>
    <film:Track source={ending-text.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
