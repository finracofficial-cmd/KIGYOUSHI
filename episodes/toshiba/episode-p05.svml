<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p05). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch05>
      最初に手放したのは、医療機器でした。<2016年|にせんじゅうろくねん>、<東芝メディカルシステムズ|とうしばめでぃかるしすてむず>を、キヤノンにおよそ<6,655億円|ろくせんろっぴゃくごじゅうごおくえん>で売却します。 ||
      同じ年、洗濯機や冷蔵庫などの白物家電事業を、中国の<美的集団|びてきしゅうだん>に売却。<東芝|とうしば>のブランドは、その後も<40年間|よんじゅうねんかん>使えることになりました。 ||
      <2017年12月|にせんじゅうななねんじゅうにがつ>には、上場廃止を避けるため、およそ<6,000億円|ろくせんおくえん>の増資を実施します。 ||
      引き受け先は<60|ろくじゅう>に上り、その多くは海外の投資ファンドでした。この決断が、のちの<東芝|とうしば>の行方を大きく左右します。 ||
      @{b-ch05-01!}そして<2018年6月|にせんじゅうはちねんろくがつ>、<東芝|とうしば>は、最大の稼ぎ頭だった半導体メモリー事業を手放します。 ||
      売却額は、およそ<2兆円|にちょうえん>。買い手は、アメリカの投資ファンド、ベインキャピタルを中心とする企業連合でした。 ||
      舛岡さんらが生んだフラッシュメモリーの事業は、<東芝|とうしば>の外へ出ていきます。 ||
      会社は<2019年|にせんじゅうきゅうねん>、<「キ|キ>オクシア」と名前を変えました。日本語の<「記|記>憶」と、価値を意味するギリシャ語を組み合わせた名前です。 ||
      <東芝|とうしば>にとって、最も利益を生んでいた事業でした。それを手放さなければ、会社そのものが生き残れなかったのです。 ||
      @{b-ch05-02!}<2018年|にせんじゅうはちねん>には、テレビ事業を中国のハイセンスに、およそ<129億円|ひゃくにじゅうきゅうおくえん>で売却。 ||
      同じ年、ダイナブックのパソコン事業を、シャープにおよそ<40億円|よんじゅうおくえん>で売却しました。 ||
      <東芝|とうしば>の名前の付いた製品は、今もお店に並んでいます。しかし、それを作る会社の多くは、もう<東芝|とうしば>のものではありません。 ||
      @{b-ch05-03!}<2018年3月|にせんじゅうはちねんさんがつ>、<『サ|サ>ザエさん』の放送から、<東芝|とうしば>の提供が外れます。 ||
      <1969年|せんきゅうひゃくろくじゅうきゅうねん>から、およそ<50年|ごじゅうねん>。日曜日の夕方に流れていた<東芝|とうしば>の名前は、静かに消えました。 ||
      しかし、<東芝|とうしば>の物語は、ここで終わりではありませんでした。
    </ch05>
  </script>
  <asset:Image id="img-selling-off" src="./assets/derived/img/selling-off.jpg"/>
  <asset:Image id="img-memory-chip" src="./assets/derived/img/memory-chip.jpg"/>
  <asset:Image id="img-living-room-tv-2018" src="./assets/derived/img/living-room-tv-2018.jpg"/>
  <asset:Image id="img-sazae-sunday-2018" src="./assets/derived/img/sazae-sunday-2018.jpg"/>
  <asset:Audio id="narr-ch05" src="./assets/narration/ch05.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-selling-off" width="1536" height="1024"/>
  <space:Extent id="ext-memory-chip" width="1536" height="1024"/>
  <space:Extent id="ext-living-room-tv-2018" width="1536" height="1024"/>
  <space:Extent id="ext-sazae-sunday-2018" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch05-media" source={narr-ch05} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch05-align" narrative={story} segment={story.segment.ch05} media={ch05-media.media} domain={ch05-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="ch05-tail.end">
    <time:Window id="card-ch05" from="start" for="4s"/>
    <time:Window id="ch05" from="card-ch05.end" for={ch05-media.extent}/>
    <time:Window id="ch05-tail" from="ch05.end" for="1200ms"/>
    <time:Window id="body-ch05" from="ch05.start" until="ch05-tail.end"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch05-align.alignment} domain={ch05-media.domain} window={film.ch05}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch05-01-at" projection={story-time} at={story.moment.b-ch05-01}/>
  <time:Instant id="b-ch05-01-in" timeline={film.timeline} at={b-ch05-01-at} offset="-16f"/>
  <time:Instant id="b-ch05-01-done" timeline={film.timeline} at={b-ch05-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch05-02-at" projection={story-time} at={story.moment.b-ch05-02}/>
  <time:Instant id="b-ch05-02-in" timeline={film.timeline} at={b-ch05-02-at} offset="-16f"/>
  <time:Instant id="b-ch05-02-done" timeline={film.timeline} at={b-ch05-02-at} offset="+8f"/>
  <semantic:Instant id="b-ch05-03-at" projection={story-time} at={story.moment.b-ch05-03}/>
  <time:Instant id="b-ch05-03-in" timeline={film.timeline} at={b-ch05-03-at} offset="-16f"/>
  <time:Instant id="b-ch05-03-done" timeline={film.timeline} at={b-ch05-03-at} offset="+8f"/>
  <time:Window id="show-ch05-00" timeline={film.timeline} from={film.ch05.start} until={b-ch05-01-done}/>
  <time:Window id="show-ch05-01" timeline={film.timeline} from={b-ch05-01-in} until={b-ch05-02-done}/>
  <time:Window id="show-ch05-02" timeline={film.timeline} from={b-ch05-02-in} until={b-ch05-03-done}/>
  <time:Window id="show-ch05-03" timeline={film.timeline} from={b-ch05-03-in} until={film.ch05-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch05-00" image={img-selling-off} extent={ext-selling-off} during={show-ch05-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch05-01" image={img-memory-chip} extent={ext-memory-chip} during={show-ch05-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch05-02" image={img-living-room-tv-2018} extent={ext-living-room-tv-2018} during={show-ch05-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch05-03" image={img-sazae-sunday-2018} extent={ext-sazae-sunday-2018} during={show-ch05-03} frame={full} z="13" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch05" source={ch05-media.media} during={film.ch05}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch05" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch05} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch05" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch05}>FILE</text:Flow>
  <text:Flow id="theme-main-ch05" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch05} motion={text-fade}>なぜ「東芝」は解体されたのか？</text:Flow>
  <text:Flow id="theme-sub-ch05" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch05} motion={text-fade}>売上7兆円の名門、150年の栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch05" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch05} motion={text-fade}>FILE 05</text:Flow>
  <text:Flow id="card-title-ch05" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch05} motion={text-fade}>切り売り</text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch05.visual}/>
    <film:Track source={logo-sub-body-ch05.visual}/>
    <film:Track source={theme-main-ch05.visual}/>
    <film:Track source={theme-sub-ch05.visual}/>
    <film:Track source={card-num-ch05.visual}/>
    <film:Track source={card-title-ch05.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
