<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p00). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <op>
      炊飯器、洗濯機、冷蔵庫、テレビ。 ||
      日本の家庭に並んだ家電の多くで、<「日|日>本初」をうたってきた会社があります。 ||
      日曜日の夕方、テレビから流れる<『サ|サ>ザエさん』。この番組を、長年スポンサーとして支えたのも、その会社でした。 ||
      <東芝|とうしば>です。 ||
      @{b-op-01!}最盛期の<2008年3月期|にせんはちねんさんがつき>、連結売上高はおよそ<7兆6,681億円|ななちょうろくせんろっぴゃくはちじゅういちおくえん>。世界におよそ<20万人|にじゅうまんにん>の従業員を抱えていました。 ||
      しかし今、<東芝|とうしば>ブランドのテレビを作っているのは、中国のハイセンスの傘下にある会社です。 ||
      <東芝|とうしば>ブランドの洗濯機や冷蔵庫も、中国の家電大手、<美的集団|びてきしゅうだん>の傘下にあります。 ||
      @{b-op-02!}そして<2023年12月|にせんにじゅうさんねんじゅうにがつ>、<東芝|とうしば>は、<74年|ななじゅうよねん>続いた株式の上場を廃止しました。 ||
      <東芝|とうしば>は、倒産したわけではありません。会社は今もあり、利益率は過去最高を記録しています。 ||
      それなのに、なぜ。 ||
      なぜ、日本を代表する名門は、テレビも、白物家電も、パソコンも、半導体も、手放すことになったのか。 ||
      なぜ、創業から<150年|ひゃくごじゅうねん>を数える会社は、株式市場から姿を消したのか。 ||
      今回ひもとくのは、<東芝|とうしば>の栄枯盛衰です。
    </op>
  </script>
  <asset:Image id="img-op-kitchen-showa" src="./assets/derived/img/op-kitchen-showa.jpg"/>
  <asset:Image id="img-op-tv-showroom" src="./assets/derived/img/op-tv-showroom.jpg"/>
  <asset:Image id="img-op-empty-hq" src="./assets/derived/img/op-empty-hq.jpg"/>
  <asset:Image id="img-ident" src="./assets/derived/ident.jpg"/>
  <asset:Audio id="narr-op" src="./assets/narration/op.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-op-kitchen-showa" width="1536" height="1024"/>
  <space:Extent id="ext-op-tv-showroom" width="1536" height="1024"/>
  <space:Extent id="ext-op-empty-hq" width="1536" height="1024"/>
  <space:Extent id="ext-ident" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="op-media" source={narr-op} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="op-align" narrative={story} segment={story.segment.op} media={op-media.media} domain={op-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="ident.end">
    <time:Window id="op" from="start" for={op-media.extent}/>
    <time:Window id="op-tail" from="op.end" for="800ms"/>
    <time:Window id="body-op" from="op.start" until="op-tail.end"/>
    <time:Window id="ident" from="op-tail.end" for="5s"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={op-align.alignment} domain={op-media.domain} window={film.op}/>
  </semantic:Projection>
  <semantic:Instant id="b-op-01-at" projection={story-time} at={story.moment.b-op-01}/>
  <time:Instant id="b-op-01-in" timeline={film.timeline} at={b-op-01-at} offset="-16f"/>
  <time:Instant id="b-op-01-done" timeline={film.timeline} at={b-op-01-at} offset="+8f"/>
  <semantic:Instant id="b-op-02-at" projection={story-time} at={story.moment.b-op-02}/>
  <time:Instant id="b-op-02-in" timeline={film.timeline} at={b-op-02-at} offset="-16f"/>
  <time:Instant id="b-op-02-done" timeline={film.timeline} at={b-op-02-at} offset="+8f"/>
  <time:Window id="show-op-00" timeline={film.timeline} from={film.op.start} until={b-op-01-done}/>
  <time:Window id="show-op-01" timeline={film.timeline} from={b-op-01-in} until={b-op-02-done}/>
  <time:Window id="show-op-02" timeline={film.timeline} from={b-op-02-in} until={film.op-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ident" image={img-ident} extent={ext-ident} during={film.ident} frame={full} z="5" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-op-00" image={img-op-kitchen-showa} extent={ext-op-kitchen-showa} during={show-op-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-op-01" image={img-op-tv-showroom} extent={ext-op-tv-showroom} during={show-op-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-op-02" image={img-op-empty-hq} extent={ext-op-empty-hq} during={show-op-02} frame={full} z="12" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-op" source={op-media.media} during={film.op}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-op" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-op} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-op" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-op}>FILE</text:Flow>
  <text:Flow id="ident-logo" timeline={film.timeline} within={ident-logo-frame} style={ident-logo-style} z="70" align="center" block-align="center" during={film.ident} motion={text-fade} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="ident-title" timeline={film.timeline} within={ident-title-frame} style={ident-title-style} z="70" align="center" block-align="center" during={film.ident} motion={text-fade}>なぜ「東芝」は解体されたのか？</text:Flow>
  <text:Flow id="ident-sub" timeline={film.timeline} within={ident-sub-frame} style={ident-sub-style} z="70" align="center" block-align="center" during={film.ident} motion={text-fade}>売上7兆円の名門、150年の栄枯盛衰</text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-op.visual}/>
    <film:Track source={logo-sub-body-op.visual}/>
    <film:Track source={ident-logo.visual}/>
    <film:Track source={ident-title.visual}/>
    <film:Track source={ident-sub.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
