<?svml using="@hypit/markup@1"?>
<!-- Generated by tools/build_svml.py from episode.json (part p03). Edit episode.json, not this file. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../../channel/look.svs"/>
  <script id="story">
    <ch03>
      <2006年2月|にせんろくねんにがつ>、<東芝|とうしば>は、アメリカの原子力メーカー、<ウェスチングハウス|うぇすちんぐはうす>の買収を発表します。 ||
      買収額は<54億ドル|ごじゅうよんおくどる>。当時のレートで、およそ<6,210億円|ろくせんにひゃくじゅうおくえん>でした。 ||
      <東芝|とうしば>は、原子力事業の売上高を、<2015年|にせんじゅうごねん>に<7,000億円|ななせんおくえん>、<2020年|にせんにじゅうねん>には<9,000億円|きゅうせんおくえん>に伸ばす目標を掲げます。 ||
      @{b-ch03-01!}このころ世界では、温暖化対策として原子力発電を見直す動きが広がっていました。<「原|原>子力ルネサンス」と呼ばれた時代です。 ||
      <東芝|とうしば>は、半導体と原子力を二本の柱とする会社へと、姿を変えようとしていました。 ||
      <2008年|にせんはちねん>、<ウェスチングハウス|うぇすちんぐはうす>は、アメリカで<4基|よんき>の原子力発電所の建設を受注します。 ||
      のちに、<東芝|とうしば>を最も深く追い詰めることになる工事でした。 ||
      @{b-ch03-02!}一方で、身近な分野ではつまずきもありました。 ||
      次世代<DVD|でぃーぶいでぃー>の規格争いで、<東芝|とうしば>は<HD DVD|えいちでぃーでぃーぶいでぃー>を推し、ソニーなどのブルーレイと競っていました。 ||
      ところが<2008年1月|にせんはちねんいちがつ>、長年の盟友だったワーナーが、ブルーレイに一本化すると発表します。 ||
      <2008年2月|にせんはちねんにがつ>、<東芝|とうしば>は撤退を発表。会見では<「も|も>はや勝ち目がない」という言葉が使われました。 ||
      同じ日に<東芝|とうしば>が発表したのは、フラッシュメモリーの新しい工場の計画でした。 ||
      家電の<東芝|とうしば>から、半導体と原子力の<東芝|とうしば>へ。会社の重心は、はっきりと移っていきます。 ||
      @{b-ch03-03!}そして、<2011年3月|にせんじゅういちねんさんがつ>。東日本大震災と、東京電力福島第一原子力発電所の事故が起きます。 ||
      世界の原子力への見方は、一変しました。 ||
      <2011年5月|にせんじゅういちねんごがつ>、当時の社長は、原子力の受注目標について<「数|数>年シフトする可能性がある」と述べています。 ||
      のちに分かることですが、<ウェスチングハウス|うぇすちんぐはうす>は、<2012年度|にせんじゅうにねんど>と<2013年度|にせんじゅうさんねんど>に、 ||
      自らの決算で、およそ<13億ドル|じゅうさんおくどる>の減損を計上していました。 ||
      しかし<東芝|とうしば>は、それを連結決算に反映せず、開示もしていませんでした。 ||
      <東芝|とうしば>はのちに、<「適|適>時適切に開示すべきでした」と認めています。
    </ch03>
  </script>
  <asset:Image id="img-boardroom-2006" src="./assets/derived/img/boardroom-2006.jpg"/>
  <asset:Image id="img-nuclear-plant-us" src="./assets/derived/img/nuclear-plant-us.jpg"/>
  <asset:Image id="img-dvd-format-war" src="./assets/derived/img/dvd-format-war.jpg"/>
  <asset:Image id="img-tsunami-2011" src="./assets/derived/img/tsunami-2011.jpg"/>
  <asset:Audio id="narr-ch03" src="./assets/narration/ch03.m4a"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Canvas id="canvas" width="1920" height="1080"/>
  <space:Extent id="ext-boardroom-2006" width="1536" height="1024"/>
  <space:Extent id="ext-nuclear-plant-us" width="1536" height="1024"/>
  <space:Extent id="ext-dvd-format-war" width="1536" height="1024"/>
  <space:Extent id="ext-tsunami-2011" width="1536" height="1024"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="theme-main-frame" within={canvas.bounds} left="1.6%" top="2.2%" right="75%" bottom="8.6%"/>
  <space:Frame id="theme-sub-frame" within={canvas.bounds} left="1.6%" top="8.9%" right="75%" bottom="13.6%"/>
  <space:Frame id="logo-frame" within={canvas.bounds} left="91.6%" top="2.2%" right="98.6%" bottom="14.6%"/>
  <space:Frame id="logo-sub-frame" within={canvas.bounds} left="90.0%" top="14.8%" right="100.0%" bottom="17.4%"/>
  <space:Frame id="card-number-frame" within={canvas.bounds} left="10%" top="33%" right="90%" bottom="44%"/>
  <space:Frame id="card-title-frame" within={canvas.bounds} left="6%" top="45%" right="94%" bottom="62%"/>
  <space:Frame id="ident-logo-frame" within={canvas.bounds} left="40%" top="22%" right="60%" bottom="57%"/>
  <space:Frame id="ident-title-frame" within={canvas.bounds} left="6%" top="62%" right="94%" bottom="74%"/>
  <space:Frame id="ident-sub-frame" within={canvas.bounds} left="6%" top="74%" right="94%" bottom="82%"/>
  <space:Frame id="credits-frame" within={canvas.bounds} left="14%" top="0%" right="86%" bottom="100%"/>
  <space:Frame id="ending-frame" within={canvas.bounds} left="10%" top="30%" right="90%" bottom="70%"/>
  <mediaop:Normalize id="ch03-media" source={narr-ch03} video="none" audio="default" span-authority="audio" clock={clock}/>
  <whisperx:Alignment id="ch03-align" narrative={story} segment={story.segment.ch03} media={ch03-media.media} domain={ch03-media.domain} language="ja"/>
  <time:Timeline id="film" clock={clock} end="ch03-tail.end">
    <time:Window id="card-ch03" from="start" for="4s"/>
    <time:Window id="ch03" from="card-ch03.end" for={ch03-media.extent}/>
    <time:Window id="ch03-tail" from="ch03.end" for="1200ms"/>
    <time:Window id="body-ch03" from="ch03.start" until="ch03-tail.end"/>
  </time:Timeline>
  <semantic:Projection id="story-time" narrative={story} timeline={film.timeline}>
    <semantic:Map alignment={ch03-align.alignment} domain={ch03-media.domain} window={film.ch03}/>
  </semantic:Projection>
  <semantic:Instant id="b-ch03-01-at" projection={story-time} at={story.moment.b-ch03-01}/>
  <time:Instant id="b-ch03-01-in" timeline={film.timeline} at={b-ch03-01-at} offset="-16f"/>
  <time:Instant id="b-ch03-01-done" timeline={film.timeline} at={b-ch03-01-at} offset="+8f"/>
  <semantic:Instant id="b-ch03-02-at" projection={story-time} at={story.moment.b-ch03-02}/>
  <time:Instant id="b-ch03-02-in" timeline={film.timeline} at={b-ch03-02-at} offset="-16f"/>
  <time:Instant id="b-ch03-02-done" timeline={film.timeline} at={b-ch03-02-at} offset="+8f"/>
  <semantic:Instant id="b-ch03-03-at" projection={story-time} at={story.moment.b-ch03-03}/>
  <time:Instant id="b-ch03-03-in" timeline={film.timeline} at={b-ch03-03-at} offset="-16f"/>
  <time:Instant id="b-ch03-03-done" timeline={film.timeline} at={b-ch03-03-at} offset="+8f"/>
  <time:Window id="show-ch03-00" timeline={film.timeline} from={film.ch03.start} until={b-ch03-01-done}/>
  <time:Window id="show-ch03-01" timeline={film.timeline} from={b-ch03-01-in} until={b-ch03-02-done}/>
  <time:Window id="show-ch03-02" timeline={film.timeline} from={b-ch03-02-in} until={b-ch03-03-done}/>
  <time:Window id="show-ch03-03" timeline={film.timeline} from={b-ch03-03-in} until={film.ch03-tail.end}/>
  <visual:Motion id="fade-in">
    <visual:Pose at="start" opacity="0" easing="ease-in-out"/>
    <visual:Pose at="24f" opacity="1"/>
    <visual:Pose at="end" opacity="1"/>
  </visual:Motion>
  <visual:Track id="picture" timeline={film.timeline}>
    <visual:Clip id="pic-ch03-00" image={img-boardroom-2006} extent={ext-boardroom-2006} during={show-ch03-00} frame={full} z="10" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch03-01" image={img-nuclear-plant-us} extent={ext-nuclear-plant-us} during={show-ch03-01} frame={full} z="11" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch03-02" image={img-dvd-format-war} extent={ext-dvd-format-war} during={show-ch03-02} frame={full} z="12" fit="cover" motion={fade-in}/>
    <visual:Clip id="pic-ch03-03" image={img-tsunami-2011} extent={ext-tsunami-2011} during={show-ch03-03} frame={full} z="13" fit="cover" motion={fade-in}/>
  </visual:Track>
  <audio:Track id="mix" timeline={film.timeline}>
    <audio:Clip id="voice-ch03" source={ch03-media.media} during={film.ch03}/>
  </audio:Track>
  <fonts:Face id="jp-black" package="@fontsource-variable/noto-sans-jp" weight="900" style="normal"/>
  <fonts:Face id="jp-bold" package="@fontsource-variable/noto-sans-jp" weight="700" style="normal"/>
  <text:Style id="theme-main-style" recipe={look.text.theme-main} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#1B1B1BE6" padding="6 18" radius="0" border-color="#C9A45C" border-width="0 0 0 8"/></text:Style>
  <text:Style id="theme-sub-style" recipe={look.text.theme-sub} font={jp-bold}><text:Fill color="#FFFFFF"/><text:Box target="line" color="#A81E1EE6" padding="5 16" radius="0"/></text:Style>
  <text:Style id="logo-style" recipe={look.text.logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="10 12" radius="6" border-color="#FFFFFF" border-width="3"/></text:Style>
  <text:Style id="logo-sub-style" recipe={look.text.logo-sub} font={jp-bold}><text:Stroke color="#000000" width="3" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-logo-style" recipe={look.text.ident-logo} font={jp-black}><text:Fill color="#FFFFFF"/><text:Box target="content" color="#A81E1E" padding="26 30" radius="14" border-color="#FFFFFF" border-width="6"/></text:Style>
  <text:Style id="ident-title-style" recipe={look.text.ident-title} font={jp-black}><text:Stroke color="#000000" width="8" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="ident-sub-style" recipe={look.text.ident-sub} font={jp-bold}><text:Stroke color="#000000" width="6" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-number-style" recipe={look.text.card-number} font={jp-bold}><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="card-title-style" recipe={look.text.card-title} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-style" recipe={look.text.credits} font={jp-bold}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#FFFFFF"/></text:Style>
  <text:Style id="credits-head-style" recipe={look.text.credits-head} font={jp-black}><text:Stroke color="#000000" width="5" placement="outside"/><text:Fill color="#C9A45C"/></text:Style>
  <text:Style id="ending-style" recipe={look.text.ending} font={jp-black}><text:Fill color="#FFFFFF"/></text:Style>
  <text:Motion id="text-fade"><text:ItemKeyframe at="0" opacity="0"/><text:ItemKeyframe at="12" opacity="1"/></text:Motion>
  <text:Flow id="logo-body-ch03" timeline={film.timeline} within={logo-frame} style={logo-style} z="80" align="center" block-align="center" during={film.body-ch03} inline-size="hug" block-size="hug"><text:P>栄枯<text:Break/>盛衰</text:P></text:Flow>
  <text:Flow id="logo-sub-body-ch03" timeline={film.timeline} within={logo-sub-frame} style={logo-sub-style} z="80" align="center" block-align="center" during={film.body-ch03}>FILE</text:Flow>
  <text:Flow id="theme-main-ch03" timeline={film.timeline} within={theme-main-frame} style={theme-main-style} z="60" align="start" block-align="center" during={film.body-ch03} motion={text-fade}>なぜ「東芝」は解体されたのか？</text:Flow>
  <text:Flow id="theme-sub-ch03" timeline={film.timeline} within={theme-sub-frame} style={theme-sub-style} z="60" align="start" block-align="center" during={film.body-ch03} motion={text-fade}>売上7兆円の名門、150年の栄枯盛衰</text:Flow>
  <text:Flow id="card-num-ch03" timeline={film.timeline} within={card-number-frame} style={card-number-style} z="60" align="center" block-align="end" during={film.card-ch03} motion={text-fade}>FILE 03</text:Flow>
  <text:Flow id="card-title-ch03" timeline={film.timeline} within={card-title-frame} style={card-title-style} z="60" align="center" block-align="start" during={film.card-ch03} motion={text-fade}>二つの賭け</text:Flow>
  <caption-fine:Style id="caption-style" recipe={look.caption.primary} font={jp-black}/>
  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing} timeline={film.timeline} within={canvas.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>
  <film:Film id="main" canvas={canvas.canvas} timeline={film.timeline} appearance={look.film.main}>
    <film:Track source={picture.visual}/>
    <film:Track source={mix.audio}/>
    <film:Track source={logo-body-ch03.visual}/>
    <film:Track source={logo-sub-body-ch03.visual}/>
    <film:Track source={theme-main-ch03.visual}/>
    <film:Track source={theme-sub-ch03.visual}/>
    <film:Track source={card-num-ch03.visual}/>
    <film:Track source={card-title-ch03.visual}/>
    <film:Track source={captions.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={film.timeline}/>
</svml>
